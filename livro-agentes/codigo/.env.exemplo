# Copie para .env e ajuste. Sem .env, o livro roda 100% local (PROVEDOR=local).
# PROVEDOR=local        -> Ollama no Docker, gratuito
# PROVEDOR=anthropic    -> API do Claude (exige ANTHROPIC_API_KEY)
# PROVEDOR=compativel   -> qualquer API no dialeto OpenAI (exige BASE_URL, CHAVE e MODELO)
PROVEDOR=local
# MODELO=qwen2.5:7b
# MODELO_RESERVA=qwen2.5:3b
# ANTHROPIC_API_KEY=
# BASE_URL=
# CHAVE=
